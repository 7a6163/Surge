#!name=Ecosia → Kagi
#!desc=Redirect Safari Ecosia searches to Kagi v202609231200
#!category=Utility
#!arguments=Token
#!arguments-desc=Paste ONLY the token from your Kagi Session Link (kagi.com/settings → Account → Session Link): the part between "token=" and "&q=", not the whole link

[URL Rewrite]
^https:\/\/www\.ecosia\.org\/search\?(?:.*&)?q=([^&]*).* https://kagi.com/search?token={{{Token}}}&q=$1 307

[MITM]
hostname = %APPEND% www.ecosia.org
