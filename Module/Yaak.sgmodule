#!name=Yaak License Activate Bypass
#!desc=Short-circuit POST license.yaak.app/licenses/activate and return fixed JSON without upstream call v202608060001
#!category=Unlock

[Script]
Yaak-License = type=http-request, pattern=^https:\/\/license\.yaak\.app\/licenses\/activate(\?|$), script-path=https://raw.githubusercontent.com/7a6163/Surge/main/Script/Yaak-license.js, requires-body=false, timeout=10

[MITM]
hostname = %APPEND% license.yaak.app
